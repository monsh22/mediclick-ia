# =============================================================
#  .env para el SERVIDOR en la nube
#  En el servidor:  cp .env.prod.example .env   y llena los valores
#  Genera contraseñas fuertes con:  openssl rand -hex 24
# =============================================================

# ---- Tus dominios (DuckDNS, gratis) ----
# Si en DuckDNS registraste "mediclick-fer", tus dominios son:
API_DOMAIN=api.mediclick-fer.duckdns.org
N8N_DOMAIN=n8n.mediclick-fer.duckdns.org
APP_DOMAIN=app.mediclick-fer.duckdns.org

# ---- Contraseñas: CÁMBIALAS (el servidor está en internet) ----
POSTGRES_USER=mediclick
POSTGRES_PASSWORD=pon-aqui-una-contrasena-larga
RABBITMQ_USER=mediclick
RABBITMQ_PASS=pon-aqui-otra-contrasena-larga
JWT_SECRET=pon-aqui-un-secreto-muy-largo

# ---- IA ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
XAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# true = recordatorios rápidos para presentar; false = 24 h y 2 h reales
DEMO_FAST_REMINDERS=true

# No se usa en producción (n8n toma su URL de N8N_DOMAIN)
N8N_PUBLIC_URL=
