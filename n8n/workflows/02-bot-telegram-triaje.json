{
  "name": "MediClick - Bot de Telegram (triaje)",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000001",
      "name": "Mensaje de Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        220,
        300
      ],
      "webhookId": "mediclick-telegram"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.message.text }}",
              "operation": "startsWith",
              "value2": "/start"
            }
          ]
        }
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000002",
      "name": "¿Es /start?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "=¡Hola! Soy el bot de MediClick AI 🩺\n\nTu ID de chat es: {{ $json.message.chat.id }}\nCópialo en la app (Perfil → ID de chat de Telegram) para recibir tus recordatorios.\n\nTambién puedes escribirme tus síntomas y te sugiero una especialidad.\n🚨 Si es una emergencia llama al 911.",
        "additionalFields": {}
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000003",
      "name": "Responder bienvenida",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        700,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://triage-service:3004/internal/triage/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $json.message.text, channel: 'telegram' }) }}",
        "options": {}
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000004",
      "name": "Triaje IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        420
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Mensaje de Telegram').item.json.message.chat.id }}",
        "text": "={{ $json.reply.replaceAll('**', '') }}\n\n{{ $json.specialty ? '📅 Agenda tu cita de ' + $json.specialty + ' en la app MediClick AI.' : '' }}",
        "additionalFields": {}
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000005",
      "name": "Responder triaje",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        940,
        420
      ]
    }
  ],
  "connections": {
    "Mensaje de Telegram": {
      "main": [
        [
          {
            "node": "¿Es /start?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Es /start?": {
      "main": [
        [
          {
            "node": "Responder bienvenida",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Triaje IA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Triaje IA": {
      "main": [
        [
          {
            "node": "Responder triaje",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}