# =============================================================
#  Copia este archivo como .env  (en la misma carpeta)
#  Windows:  copy .env.example .env
#  Mac/Linux: cp .env.example .env
# =============================================================

# Base de datos
POSTGRES_USER=mediclick
POSTGRES_PASSWORD=mediclick123

# RabbitMQ (usuario y contraseña del panel http://localhost:15672)
RABBITMQ_USER=mediclick
RABBITMQ_PASS=mediclick123

# Secreto para firmar los tokens de sesión (cámbialo por cualquier texto largo)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-dificil-2026

# IA (opcional). Pon SOLO UNA. Si todas están vacías, el triaje funciona
# en "modo local" usando solo el RAG (sin LLM).
# Groq (gratis): https://console.groq.com/keys   -> empieza con gsk_
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Grok de xAI: https://console.x.ai               -> empieza con xai-
XAI_API_KEY=
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Recordatorios rápidos para la demo: true = el "recordatorio 24h" llega
# a los 30 segundos y el "2h" al minuto de agendar (para presentar).
DEMO_FAST_REMINDERS=true

# ---- Telegram con ngrok (dominio fijo, gratis) ----
# 1) Cuenta gratis en https://ngrok.com
# 2) Token: panel de ngrok -> "Your Authtoken"
# 3) Dominio: panel de ngrok -> "Domains" (ej. abc-def-123.ngrok-free.app)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# URL pública de n8n = https:// + tu dominio de ngrok + /
N8N_PUBLIC_URL=http://localhost:5678/
